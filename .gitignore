# Local data (keep shared reference files)
/data/*
/descriptives/*.csv
!/data/shared_*

# Generated analysis outputs
/output/

# Presentation / slide exports
/neat_results/

# Python
.venv/
__pycache__/
*.pyc

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# Secrets — never commit (Box CCG credentials for New_Pipeline.sweep --box, etc.)
.env
.env.*

# Debug / scratch
debuggggg.csv

# leonardo_nodes pipeline — generated, not source
# (.gitignore does not allow inline comments; keep patterns on their own lines)
# content-addressed process archive (rebuilt on register)
/.leonardo_nodes_store/
# per-run manifests + table CSVs
/runs/
# frozen oracle + pipeline parquet artifacts (regenerated by run.py / capture)
# starred so the one exception below can be negated -- git does not descend into an
# ignored DIRECTORY, so `!.../robustness/` only works if the parent is not itself ignored
/parity/artifacts/*
# ...except the robustness baselines, which are a COMMITTED reference point rather than
# regenerated output: a regression baseline nobody can clone is not a baseline
!/parity/artifacts/robustness/
# sweep ledger + derived PDF/CSV + per-run artifacts (New_Pipeline.sweep)
/sweep_output/
